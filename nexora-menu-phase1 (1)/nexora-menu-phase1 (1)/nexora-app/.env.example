# ── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NEXORA Menu"

# ── Supabase (Auth + Storage) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ── Database (Prisma → Supabase Postgres) ─────────────────
# Pooled connection, used at runtime
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection, used for migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ── Stripe (Subscriptions) ─────────────────────────────────
STRIPE_SECRET_KEY="PASTE_STRIPE_TEST_SECRET_HERE"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="PASTE_STRIPE_PUBLISHABLE_HERE"
STRIPE_WEBHOOK_SECRET="PASTE_STRIPE_WEBHOOK_HERE"

STRIPE_PRICE_STARTER="price_xxxxxxxxxxxx"
STRIPE_PRICE_PRO="price_xxxxxxxxxxxx"
STRIPE_PRICE_BUSINESS="price_xxxxxxxxxxxx"
